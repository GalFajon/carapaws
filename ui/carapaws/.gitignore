# Dependencies
node_modules/

# Vite and application build output
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo

# Generated documentation output
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/api/

# Local environment files and secrets
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android local configuration and build output
android/.gradle/
android/.idea/
android/**/build/
android/local.properties
android/captures/
android/.externalNativeBuild/
android/.cxx/
android/*.iml
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class

# Files copied or generated by Capacitor during sync
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
android/capacitor-cordova-android-plugins/

# Signing material must never be committed
*.jks
*.keystore
keystore.properties

# iOS local/generated files, ready for a future Capacitor iOS target
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/App/DerivedData/
ios/App/xcuserdata/
ios/App/*.xcworkspace/xcuserdata/
